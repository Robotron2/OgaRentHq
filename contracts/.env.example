# ============================================================
# OgaRent — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ------------------------------------------------------------
# Deployment Private Key
# ------------------------------------------------------------
# The private key of the deployer EOA.
# Must hold BOT tokens for gas on the target network.
# Format: 0x-prefixed hex string
PRIVATE_KEY=0x

# ------------------------------------------------------------
# BOT Chain Testnet (Bohr) — Chain ID 968
# ------------------------------------------------------------
RPC_BOT_TESTNET=https://rpc.bohr.life
CHAIN_ID_TESTNET=968
EXPLORER_BOT_TESTNET=https://scan.bohr.life/

# ------------------------------------------------------------
# BOT Chain Mainnet — Chain ID 677
# ------------------------------------------------------------
RPC_BOT_MAINNET=https://rpc.botchain.ai
CHAIN_ID_MAINNET=677
EXPLORER_BOT_MAINNET=https://scan.botchain.ai/

# ------------------------------------------------------------
# Contract Addresses (populated after deployment)
# ------------------------------------------------------------
MOCK_USDC_ADDRESS=
ESCROW_ADDRESS=

# ------------------------------------------------------------
# Escrow Role Addresses (populated before initialization)
# ------------------------------------------------------------
PLATFORM_ADMIN_ADDRESS=
TENANT_ADDRESS=
LANDLORD_ADDRESS=
AGENT_ADDRESS=

# ------------------------------------------------------------
# Block Explorer API Key (for contract verification)
# ------------------------------------------------------------
# Leave empty if the BOT Chain explorer does not require an API key.
BOTSCAN_API_KEY=

# ------------------------------------------------------------
# Escrow Initialization Parameters
# ------------------------------------------------------------
# All amounts in mUSDC atomic units (6 decimals).
# Example: 1000 mUSDC = 1000_000000 = 1000000000
RENT_AMOUNT=1000000000
AGENT_FEE=100000000
CAUTION_DEPOSIT=200000000
